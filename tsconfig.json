{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "rootDir": "./",
    "jsx": "react-jsx",
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
